# ─────────────────────────────────────────────────
# RepoFlow Environment Configuration
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────────

# ── Database (PostgreSQL) ──────────────────────────
DATABASE_URL=postgresql://repoflow:repoflow_dev@localhost:5432/repoflow?schema=public

# ── Server ──────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ── GitHub ──────────────────────────────────────────
GITHUB_TOKEN=ghp_your_github_personal_access_token

# ── OpenAI ──────────────────────────────────────────
OPENAI_API_KEY=sk-your_openai_api_key

# ── Pinecone ────────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=repoflow-chunks

# ── Logging ─────────────────────────────────────────
LOG_LEVEL=debug
